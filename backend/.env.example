# ─── OBLIGATORIAS ────────────────────────────────────────────────
# Sin estas dos el servidor no arranca.

# Secreto para firmar los JWT. Usa un valor largo y aleatorio, distinto
# por ambiente. Generar con: openssl rand -base64 48
JWT_SECRET=

# Cadena de conexion de Postgres (Neon). Usar el endpoint con pooler:
# en serverless cada invocacion abre su propia conexion.
DATABASE_URL=postgresql://user:password@host/aseada?sslmode=require

# ─── OPCIONALES ──────────────────────────────────────────────────

# Solo para `node server.js` en local. En Vercel no aplica.
PORT=3000

# ─── SEGURIDAD ───────────────────────────────────────────────────

# Desde que origenes acepta llamadas la API cuando quien llama es un
# navegador, separados por coma y sin barra final. Si se deja vacia, la API
# responde a CUALQUIER sitio (asi estaba antes) y avisa en el log: sirve para
# no romper un deploy, no para dejarlo asi.
# Ejemplo: https://app.aseada.cl,https://aseada.cl
CORS_ORIGINS=

# Verificacion del certificado TLS de Postgres. Por defecto se verifica de
# verdad: Neon presenta un certificado valido y sin esto cualquiera que se
# meta en el camino puede leer lo que viaja a la base.
#
# Ponerla en true la desactiva. Es la marcha atras de un solo paso si algun
# ambiente usa un certificado propio y TODAS las rutas empiezan a fallar con
# "self-signed certificate" o "unable to verify the first certificate":
#   npx vercel env add DB_SSL_NO_VERIFY   -> escribir: true
# y volver a desplegar. Dejarla vacia o en false es lo correcto en Neon.
DB_SSL_NO_VERIFY=

# ─── PAGOS (Flow) ────────────────────────────────────────────────
# Si falta cualquiera de las tres, el servidor arranca igual pero las
# rutas de pago responden 503 en vez de fallar con un error confuso.

FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://www.flow.cl/api

# URL publica del backend, a la que Flow envia la confirmacion del pago.
# Debe ser el dominio estable, no la URL de un deploy puntual.
# Ejemplo: https://aseada-backend.vercel.app
PUBLIC_URL=

# URL de la app web, adonde vuelve el cliente despues de pagar. Si se deja
# vacia se usa el deep link aseada://, que solo funciona en la app movil
# instalada: en un navegador deja al cliente en una pantalla muerta.
# Ejemplo: https://app.aseada.cl
APP_URL=

# ─── PAGOS A TRABAJADORES ────────────────────────────────────────
# Protege el proceso diario que libera pagos (/api/cron/diario). Vercel lo
# envia solo en las ejecuciones programadas. Generar con: openssl rand -hex 32
CRON_SECRET=

# true si Aseada retiene el 15,25% de honorarios y lo paga al SII (se
# transfiere el liquido). false si el trabajador declara por su cuenta (se
# transfiere el bruto). Depende del modelo legal: definirlo con un contador.
ASEADA_RETIENE_HONORARIOS=false
